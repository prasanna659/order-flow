# API Gateway — all REST calls (login, register, orders, catalog, health)
# Must include https:// — without the protocol axios builds broken URLs
VITE_API_BASE_URL=https://your-gateway.up.railway.app

# Auth-service direct URL — only for the Google OAuth2 redirect flow
# The OAuth2 browser redirect must go directly to auth-service, not the gateway
VITE_AUTH_DIRECT_URL=https://your-auth-service.up.railway.app
