# API Gateway — all REST API calls (login, register, orders, catalog, health)
VITE_API_BASE_URL=order-flow-production-c2fc.up.railway.app

# Auth-service DIRECT — only for the Google OAuth2 redirect flow.
# The OAuth2 flow must bypass the reactive gateway (WebFlux cannot proxy
# stateful servlet OAuth2 redirects). After the Google callback, the JWT
# is returned to the frontend and all subsequent calls go through the gateway.
VITE_AUTH_DIRECT_URL=http://localhost:8081
