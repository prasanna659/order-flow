# Copy to .env and fill in. `docker compose up --build` reads this file.
# NEVER commit the real .env (it is in .gitignore).

# --- Required -----------------------------------------------------------
# Postgres superuser password (one Postgres hosts authdb, orderdb, inventorydb)
DB_PASSWORD=change-me
# Shared by auth-service (signs tokens) and api-gateway (verifies them). Min 32 chars.
# Generate one with:  openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Optional -----------------------------------------------------------
# Google sign-in. Leave blank to disable it (email/password login still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Order emails. Set MAIL_ENABLED=false to skip sending. For Gmail use an App Password.
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Where the browser reaches the frontend (used for CORS and links in emails)
FRONTEND_URL=http://localhost:3000
